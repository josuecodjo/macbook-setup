# ~/.gitconfig — managed by macbook-setup.
# Identity and signing live in ~/.gitconfig.local (not in git).

[init]
	defaultBranch = main
[core]
	pager = delta
	excludesFile = ~/.config/git/ignore
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rebase]
	autoStash = true
	updateRefs = true
[rerere]
	enabled = true
[diff]
	algorithm = histogram
	colorMoved = default
[merge]
	conflictStyle = zdiff3
[branch]
	sort = -committerdate
[alias]
	st = status -sb
	co = checkout
	sw = switch
	lg = log --graph --oneline --decorate -20
	amend = commit --amend --no-edit
	wt = worktree
	wtl = worktree list
	undo = reset --soft HEAD~1

[include]
	path = ~/.gitconfig.local
