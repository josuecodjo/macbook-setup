# Ghostty — the fast, ad-hoc terminal. Repo work lives in Orca.
# Themes: run `ghostty +list-themes` and set `theme = <name>`.

font-family = JetBrainsMono Nerd Font
font-size = 14
window-padding-x = 8
window-padding-y = 6
window-save-state = always
macos-option-as-alt = true
copy-on-select = clipboard
confirm-close-surface = false

# Drop-down terminal from anywhere: Cmd+` (needs Accessibility permission)
keybind = global:cmd+grave_accent=toggle_quick_terminal
quick-terminal-position = top
